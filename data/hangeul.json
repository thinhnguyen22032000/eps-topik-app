  "rules": [
    { "title": "Quy tắc ghép vần", "body": "Âm tiết = phụ âm đầu + nguyên âm (+ patchim). Nguyên âm đứng dọc (ㅏ ㅣ ㅓ ㅐ…) viết bên PHẢI phụ âm; nguyên âm ngang (ㅗ ㅜ ㅡ) viết bên DƯỚI phụ âm. Nếu không có phụ âm đầu thì viết ㅇ (câm).", "examples": [["ㄱ + ㅏ", "가"], ["ㄱ + ㅗ", "고"], ["ㅂ + ㅏ + ㅂ", "밥"], ["ㅇ + ㅗ + ㅅ", "옷"]] },
    { "title": "Nối âm (연음)", "body": "Khi patchim gặp âm tiết sau bắt đầu bằng ㅇ (câm), patchim được chuyển sang đọc nối với âm tiết sau.", "examples": [["음악", "[으막]"], ["한국어", "[한구거]"], ["있어요", "[이써요]"], ["집에", "[지베]"]] },
    { "title": "Âm mũi hóa (비음화)", "body": "Patchim [ㄱ, ㄷ, ㅂ] đứng trước ㄴ, ㅁ thì đọc thành [ㅇ, ㄴ, ㅁ].", "examples": [["감사합니다", "[감사함니다]"], ["국물", "[궁물]"], ["받는", "[반는]"]] },
    { "title": "Căng hóa (경음화)", "body": "Sau patchim [ㄱ, ㄷ, ㅂ], các phụ âm ㄱ ㄷ ㅂ ㅅ ㅈ ở đầu âm tiết sau thường đọc căng.", "examples": [["학교", "[학꾜]"], ["국밥", "[국빱]"], ["입구", "[입꾸]"]] },
    { "title": "ㅎ nhẹ đi (ㅎ 탈락)", "body": "Patchim ㅎ gần như không đọc khi nối với nguyên âm sau.", "examples": [["좋아요", "[조아요]"], ["많이", "[마니]"]] }
  ]
