      "title": "Làm việc trên cao",
      "situation": "Tổ trưởng dặn dò ở công trường.",
      "lines": [
        {
          "speaker": "반장",
          "ko": "높은 곳에서는 안전벨트를 매세요.",
          "vi": "Ở nơi cao hãy thắt dây an toàn."
        },
        {
          "speaker": "응우옌",
          "ko": "벽돌은 어디로 옮겨요?",
          "vi": "Gạch chuyển đi đâu ạ?"
        },
        {
          "speaker": "반장",
          "ko": "2층으로 옮기세요. 크레인 아래로 가지 마세요.",
          "vi": "Hãy chuyển lên tầng 2. Đừng đi dưới cần cẩu."
        },
        {
          "speaker": "응우옌",
          "ko": "네, 조심하면서 일하겠습니다.",
          "vi": "Vâng, tôi sẽ vừa cẩn thận vừa làm."
        }
      ]
