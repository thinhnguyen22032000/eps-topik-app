  "grammar": [
    {
      "id": "L01-G001",
      "pattern": "-입니다 / -입니까?",
      "meaning": "Là… (trang trọng)",
      "explanation": "Gắn sau danh từ để nói 'A là B'. Dạng trang trọng dùng với giám đốc, cấp trên.",
      "formation": "Danh từ + 입니다 / 입니까?",
      "examples": [
        {
          "ko": "저는 베트남 사람입니다.",
          "vi": "Tôi là người Việt Nam."
        },
        {
          "ko": "이것은 기계입니까?",
          "vi": "Đây có phải là máy không?"
        }
      ]
    },
    {
      "id": "L01-G002",
      "pattern": "-은/는",
      "meaning": "Trợ từ chủ đề",
      "explanation": "Nêu chủ đề của câu (thường là 'tôi', 'cái này').",
      "formation": "Có patchim: 은 · Không patchim: 는",
      "examples": [
        {
          "ko": "저는 근로자입니다.",
          "vi": "Tôi là người lao động."
        },
        {
          "ko": "사장님은 사무실에 계십니다.",
          "vi": "Giám đốc đang ở văn phòng."
        }
      ]
    },
    {
      "id": "L01-G003",
      "pattern": "-ㅂ니다 / -습니다",
      "meaning": "Đuôi câu trang trọng",
      "explanation": "Gắn vào gốc động từ/tính từ để nói trang trọng, dùng với giám đốc, tổ trưởng, khi báo cáo.",
      "formation": "Không patchim: -ㅂ니다 · Có patchim: -습니다",
      "examples": [
        {
          "ko": "저는 일합니다.",
          "vi": "Tôi làm việc."
        },
        {
          "ko": "밥을 먹습니다.",
          "vi": "Tôi ăn cơm."
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L01-D001",
      "title": "Gặp giám đốc ngày đầu đi làm",
      "situation": "Ngày đầu tiên, anh Nguyễn gặp giám đốc ở nhà máy.",
      "lines": [
        {
          "speaker": "사장님",
          "ko": "안녕하세요? 이름이 뭐예요?",
          "vi": "Chào bạn. Tên bạn là gì?"
        },
        {
          "speaker": "응우옌",
          "ko": "안녕하세요, 사장님. 저는 응우옌입니다. 베트남 사람입니다.",
          "vi": "Chào giám đốc. Tôi là Nguyễn, người Việt Nam."
        },
        {
          "speaker": "사장님",
          "ko": "만나서 반갑습니다. 오늘부터 이 공장에서 일하세요.",
          "vi": "Rất vui được gặp. Từ hôm nay bạn làm việc ở nhà máy này."
        },
        {
          "speaker": "응우옌",
          "ko": "네, 감사합니다. 열심히 하겠습니다.",
          "vi": "Vâng, cảm ơn. Tôi sẽ làm việc chăm chỉ."
        }
      ]
    },
    {
      "id": "L01-D002",
      "title": "Nhận đồ bảo hộ ở xưởng",
      "situation": "Tổ trưởng dẫn anh Nguyễn vào xưởng và dặn về đồ bảo hộ.",
      "lines": [
        {
          "speaker": "반장",
          "ko": "응우옌 씨, 이쪽으로 오세요. 여기가 작업장입니다.",
          "vi": "Anh Nguyễn, mời đi lối này. Đây là xưởng làm việc."
        },
        {
          "speaker": "응우옌",
          "ko": "네, 반장님. 안전모는 어디에 있습니까?",
          "vi": "Vâng, tổ trưởng. Mũ bảo hộ ở đâu ạ?"
        },
        {
          "speaker": "반장",
          "ko": "저기 있습니다. 작업복과 안전화도 입으세요.",
          "vi": "Ở đằng kia. Hãy mặc cả đồ bảo hộ và giày bảo hộ nữa."
        },
        {
          "speaker": "응우옌",
          "ko": "알겠습니다. 용접할 때는 보안경을 써야 합니까?",
          "vi": "Tôi hiểu. Khi hàn có phải đeo kính bảo hộ không?"
        },
        {
          "speaker": "반장",
          "ko": "네, 꼭 쓰세요. 기계는 제가 알려 줄게요.",
          "vi": "Có, nhất định phải đeo. Tôi sẽ chỉ cho anh về máy móc."
        },
        {
          "speaker": "응우옌",
          "ko": "감사합니다. 죄송합니다, 한국어를 잘 못해요.",
          "vi": "Cảm ơn ạ. Xin lỗi, tôi chưa giỏi tiếng Hàn."
        }
      ]
    }
  ],
  "culture": {
    "title": "Chào hỏi và quy tắc khi vào xưởng",
    "items": [
      {
        "h": "Cúi chào cấp trên",
        "body": "Ở Hàn Quốc, người ta chào bằng cách cúi đầu nhẹ và nói 안녕하세요. Với giám đốc hoặc người lớn tuổi, hãy cúi sâu hơn và dùng thể trang trọng (-ㅂ니다/-습니다)."
      },
      {
        "h": "Dùng hai tay",
        "body": "Khi đưa hoặc nhận giấy tờ, đồ vật từ cấp trên, nên dùng hai tay (hoặc một tay đỡ tay kia) để thể hiện sự tôn trọng."
      },
      {
        "h": "Đồ bảo hộ trước tiên",
        "body": "Trước khi vào khu vực sản xuất phải mặc đúng đồ bảo hộ quy định (mũ, giày, kính… tùy công việc). Không chắc thì hỏi tổ trưởng, không tự ý làm."
      },
      {
        "h": "Báo ngay khi có vấn đề",
        "body": "Gặp sự cố hoặc chưa hiểu chỉ dẫn, hãy nói ngay với tổ trưởng/giám đốc (보고). Nói muộn dễ gây tai nạn."
      }
    ]
  }
}