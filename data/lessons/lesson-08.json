  "dialogues": [
    {
      "id": "L08-D001",
      "title": "Mua găng tay ở cửa hàng",
      "situation": "Anh Nguyễn mua đồ bảo hộ ở cửa hàng gần nhà máy.",
      "lines": [
        {
          "speaker": "응우옌",
