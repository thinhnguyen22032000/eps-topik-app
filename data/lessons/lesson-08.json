  "grammar": [
    {
      "id": "L08-G001",
      "pattern": "얼마예요?",
      "meaning": "Bao nhiêu tiền?",
      "explanation": "Hỏi giá. Trả lời bằng số + 원 (số Hán-Hàn: 천, 만…).",
      "formation": "Danh từ + 얼마예요?",
      "examples": [
        {
          "ko": "이 장갑은 얼마예요?",
          "vi": "Đôi găng tay này bao nhiêu?"
        },
        {
          "ko": "삼천 원이에요.",
          "vi": "Ba nghìn won."
        }
      ]
    },
    {
      "id": "L08-G002",
      "pattern": "-(으)세요",
      "meaning": "Xin hãy… (mời/yêu cầu)",
      "explanation": "Yêu cầu lịch sự hoặc kính ngữ.",
      "formation": "Có patchim: -으세요 · Không: -세요",
      "examples": [
        {
          "ko": "이것을 보세요.",
          "vi": "Xin hãy xem cái này."
        },
        {
          "ko": "여기에 앉으세요.",
          "vi": "Mời ngồi đây."
        }
      ]
    }
