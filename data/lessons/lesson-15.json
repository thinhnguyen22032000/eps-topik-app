  "dialogues": [
    {
      "id": "L15-D001",
      "title": "Máy bị hỏng",
      "situation": "Báo sự cố máy với tổ trưởng.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "반장님, 기계가 고장 났어요.",
          "vi": "Tổ trưởng, máy bị hỏng rồi."
        },
        {
          "speaker": "반장",
          "ko": "먼저 전원을 끄세요. 수리 기사를 부를게요.",
          "vi": "Trước hết hãy tắt nguồn. Tôi sẽ gọi thợ sửa."
        },
        {
          "speaker": "응우옌",
          "ko": "수리한 후에 다시 켜도 돼요?",
          "vi": "Sau khi sửa xong có được bật lại không?"
        },
        {
          "speaker": "반장",
          "ko": "네, 하지만 켜기 전에 꼭 확인하세요.",
          "vi": "Được, nhưng trước khi bật nhất định phải kiểm tra."
        }
      ]
    }
