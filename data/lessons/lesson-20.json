  "dialogues": [
    {
      "id": "L20-D001",
      "title": "Hỏi giám đốc về lương, bảo hiểm",
      "situation": "Người lao động hỏi về quyền lợi.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "사장님, 질문이 있어요.",
          "vi": "Giám đốc, tôi có câu hỏi."
        },
        {
          "speaker": "사장님",
          "ko": "네, 말씀하세요.",
          "vi": "Vâng, cứ nói."
        },
        {
          "speaker": "응우옌",
          "ko": "급여는 어디로 받습니까? 보험도 있어요?",
          "vi": "Tôi nhận lương qua đâu? Có bảo hiểm không?"
        },
        {
          "speaker": "사장님",
          "ko": "은행 계좌로 받습니다. 보험은 제가 설명해 줄게요.",
          "vi": "Nhận qua tài khoản ngân hàng. Bảo hiểm tôi sẽ giải thích."
        }
      ]
