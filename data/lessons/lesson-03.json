  "dialogues": [
    {
      "id": "L03-D001",
      "title": "Hỏi đường trong nhà máy",
      "situation": "Người mới hỏi vị trí nhà vệ sinh và ký túc xá.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "실례합니다. 화장실이 어디예요?",
          "vi": "Xin lỗi, nhà vệ sinh ở đâu ạ?"
        },
        {
          "speaker": "직원",
          "ko": "저기 사무실 옆에 있어요.",
          "vi": "Ở kia, cạnh văn phòng."
        },
        {
          "speaker": "응우옌",
          "ko": "기숙사는 어디에 있어요?",
          "vi": "Ký túc xá ở đâu ạ?"
        },
        {
          "speaker": "직원",
          "ko": "기숙사는 공장 뒤에 있습니다.",
          "vi": "Ký túc xá ở phía sau nhà máy."
        }
      ]
    },
    {
      "id": "L03-D002",
      "title": "Hỏi đường đến hiệu thuốc",
      "situation": "Anh Nguyễn bị đau đầu và hỏi người qua đường.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "실례합니다. 이 근처에 약국이 있어요?",
          "vi": "Xin lỗi, gần đây có hiệu thuốc không?"
        },
        {
          "speaker": "행인",
          "ko": "네, 편의점 옆에 있어요.",
          "vi": "Có, ở cạnh cửa hàng tiện lợi."
        },
        {
          "speaker": "응우옌",
          "ko": "편의점은 어디에 있어요?",
          "vi": "Cửa hàng tiện lợi ở đâu ạ?"
        },
        {
          "speaker": "행인",
          "ko": "저기 역 앞에 있어요. 이 길로 쭉 가세요.",
          "vi": "Ở trước ga kia. Hãy đi thẳng con đường này."
        },
        {
          "speaker": "응우옌",
          "ko": "멀어요?",
          "vi": "Có xa không?"
        },
        {
          "speaker": "행인",
          "ko": "아니요, 가까워요. 걸어서 오 분 걸려요.",
          "vi": "Không, gần thôi. Đi bộ mất 5 phút."
        }
      ]
    }
  ],
  "culture": {
    "title": "Nơi cần biết và số khẩn cấp",
    "items": [
      {
        "h": "Số khẩn cấp",
        "body": "119: cứu hỏa và cấp cứu; 112: cảnh sát. Hãy lưu sẵn trong điện thoại."
      },
      {
        "h": "Hiệu thuốc và bệnh viện",
        "body": "약국 bán thuốc, một số thuốc cần đơn của bác sĩ. Khi đi khám nên mang giấy tờ tùy thân và thẻ bảo hiểm nếu có."
      },
      {
        "h": "Trung tâm hỗ trợ lao động nước ngoài",
        "body": "Nhiều địa phương có trung tâm hỗ trợ lao động nước ngoài, tư vấn bằng nhiều ngôn ngữ về hợp đồng, lương, thủ tục. Hãy hỏi công ty hoặc tra cứu số điện thoại hiện hành."
      },
      {
        "h": "Biết lối thoát hiểm ngay ngày đầu",
        "body": "Hãy xem vị trí 비상구 (lối thoát hiểm) và 소화기 (bình chữa cháy) ở nơi làm việc và ký túc xá ngay từ ngày đầu."
      }
    ]
  }
