  "grammar": [
    {
      "id": "L03-G001",
      "pattern": "-에 있습니다 / 없습니다",
      "meaning": "Ở / có / không có",
      "explanation": "Chỉ vị trí tồn tại của người, vật. Với người lớn tuổi dùng 계십니다.",
      "formation": "Nơi chốn + 에 + 있습니다",
      "examples": [
        {
          "ko": "기숙사는 공장 옆에 있습니다.",
          "vi": "Ký túc xá ở cạnh nhà máy."
        },
        {
