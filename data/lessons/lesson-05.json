  "grammar": [
    {
      "id": "L05-G001",
      "pattern": "-에 (thời gian)",
      "meaning": "Vào lúc…",
      "explanation": "Gắn sau từ chỉ thời điểm cụ thể (giờ, thứ). Không gắn với 오늘, 내일, 어제.",
      "formation": "Giờ/thứ + 에",
      "examples": [
        {
          "ko": "일곱 시에 출근합니다.",
          "vi": "Tôi đi làm lúc bảy giờ."
        },
        {
          "ko": "내일 출근합니다.",
          "vi": "Ngày mai tôi đi làm. (không dùng 에)"
        }
      ]
    },
    {
      "id": "L05-G002",
      "pattern": "-부터 -까지",
      "meaning": "Từ… đến…",
      "explanation": "Chỉ điểm bắt đầu và kết thúc của thời gian hoặc nơi chốn.",
      "formation": "A + 부터 B + 까지",
      "examples": [
        {
          "ko": "아침 여덟 시부터 저녁 여섯 시까지 일합니다.",
          "vi": "Tôi làm từ 8 giờ sáng đến 6 giờ tối."
        },
        {
          "ko": "월요일부터 금요일까지 일합니다.",
          "vi": "Tôi làm từ thứ hai đến thứ sáu."
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L05-D001",
      "title": "Hỏi giờ làm việc",
      "situation": "Đồng nghiệp hỏi về giờ đi làm, tan làm.",
      "lines": [
        {
          "speaker": "직원",
          "ko": "몇 시에 출근해요?",
          "vi": "Anh đi làm lúc mấy giờ?"
        },
        {
          "speaker": "응우옌",
          "ko": "아침 여덟 시에 출근해요.",
          "vi": "Tôi đi làm lúc 8 giờ sáng."
        },
        {
          "speaker": "직원",
          "ko": "퇴근은 몇 시예요?",
          "vi": "Mấy giờ tan làm?"
        },
        {
          "speaker": "응우옌",
          "ko": "저녁 여섯 시에 퇴근합니다. 점심시간은 열두 시부터 한 시까지예요.",
          "vi": "Tôi tan làm lúc 6 giờ tối. Nghỉ trưa từ 12 giờ đến 1 giờ."
        }
      ]
    }
  ]
