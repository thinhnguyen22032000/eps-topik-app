  "grammar": [
    {
      "id": "L19-G001",
      "pattern": "-기 때문에",
      "meaning": "Vì… nên…",
      "explanation": "Nêu nguyên nhân khách quan, dùng được với danh từ (-이기 때문에).",
      "formation": "Gốc động từ + -기 때문에",
      "examples": [
        {
