  "dialogues": [
    {
      "id": "L19-D001",
      "title": "Sóng cao, tàu không ra khơi",
      "situation": "Thuyền trưởng giao việc khi thời tiết xấu.",
      "lines": [
        {
          "speaker": "선장",
          "ko": "오늘 파도가 높기 때문에 배가 못 나갑니다.",
          "vi": "Hôm nay sóng cao nên tàu không ra khơi được."
        },
        {
          "speaker": "응우옌",
          "ko": "그럼 무엇을 할까요?",
          "vi": "Vậy tôi làm gì ạ?"
        },
        {
          "speaker": "선장",
          "ko": "그물을 고치세요. 배에서는 구명조끼를 입어야 합니다.",
          "vi": "Hãy sửa lưới. Trên tàu phải mặc áo phao."
        },
        {
          "speaker": "응우옌",
          "ko": "네, 알겠습니다. 내일은 출항하려고 해요?",
          "vi": "Vâng. Ngày mai định ra khơi ạ?"
        }
      ]
    }
