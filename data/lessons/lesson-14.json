  "dialogues": [
    {
      "id": "L14-D001",
      "title": "Quy tắc an toàn",
      "situation": "Tổ trưởng hướng dẫn an toàn cho công nhân mới.",
      "lines": [
        {
          "speaker": "반장",
          "ko": "여기는 위험하니까 조심하세요.",
          "vi": "Chỗ này nguy hiểm nên hãy cẩn thận."
        },
        {
          "speaker": "응우옌",
          "ko": "보호구를 꼭 착용해야 해요?",
          "vi": "Có nhất định phải mang đồ bảo hộ không?"
        },
        {
          "speaker": "반장",
          "ko": "네, 안전 규칙을 지켜야 합니다. 사고가 나면 바로 말하세요.",
          "vi": "Có, phải tuân thủ quy tắc an toàn. Nếu có tai nạn hãy báo ngay."
        },
        {
          "speaker": "응우옌",
          "ko": "알겠습니다. 소화기는 어디에 있어요?",
          "vi": "Tôi hiểu. Bình chữa cháy ở đâu?"
        },
        {
          "speaker": "반장",
          "ko": "문 옆에 있습니다.",
          "vi": "Ở cạnh cửa."
        }
      ]
    }
  ]
