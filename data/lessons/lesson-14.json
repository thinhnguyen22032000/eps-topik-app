  "grammar": [
    {
      "id": "L14-G001",
      "pattern": "-아/어야 하다",
      "meaning": "Phải…",
      "explanation": "Diễn tả nghĩa vụ, điều bắt buộc.",
      "formation": "Gốc động từ + 아/어야 하다 (되다)",
      "examples": [
        {
          "ko": "안전모를 써야 합니다.",
          "vi": "Phải đội mũ bảo hộ."
        },
        {
