  "grammar": [
    {
      "id": "L02-G001",
      "pattern": "-이/가",
      "meaning": "Trợ từ chủ ngữ",
      "explanation": "Chỉ chủ thể của hành động/trạng thái, nhấn thông tin mới.",
      "formation": "Có patchim: 이 · Không patchim: 가",
      "examples": [
        {
          "ko": "기계가 고장 났습니다.",
          "vi": "Máy bị hỏng rồi."
        },
        {
          "ko": "친구가 옵니다.",
          "vi": "Bạn tôi đến."
        }
      ]
    },
    {
      "id": "L02-G002",
      "pattern": "-이/가 아닙니다",
      "meaning": "Không phải là…",
      "explanation": "Phủ định của '-입니다'.",
      "formation": "Danh từ + 이/가 아닙니다",
      "examples": [
        {
          "ko": "저는 학생이 아닙니다.",
          "vi": "Tôi không phải là học sinh."
        },
        {
          "ko": "이것은 안전모가 아닙니다.",
          "vi": "Đây không phải là mũ bảo hộ."
        }
      ]
    },
    {
      "id": "L02-G003",
      "pattern": "-와/과",
      "meaning": "Và, cùng với",
      "explanation": "Nối hai danh từ, hoặc chỉ 'cùng với ai'.",
      "formation": "Có patchim: 과 · Không patchim: 와",
      "examples": [
        {
          "ko": "책과 연필이 있습니다.",
          "vi": "Có sách và bút chì."
        },
        {
          "ko": "친구와 같이 일합니다.",
          "vi": "Tôi làm cùng bạn."
        }
      ]
    }
  ],
  "dialogues": [
    {
      "id": "L02-D001",
      "title": "Hỏi quốc tịch, nghề nghiệp",
      "situation": "Hai đồng nghiệp làm quen trong giờ nghỉ.",
      "lines": [
        {
          "speaker": "민수",
          "ko": "저는 한국 사람입니다. 응우옌 씨는 어느 나라 사람이에요?",
          "vi": "Tôi là người Hàn. Anh Nguyễn là người nước nào?"
        },
        {
          "speaker": "응우옌",
          "ko": "저는 베트남 사람입니다. 민수 씨는 회사원이에요?",
          "vi": "Tôi là người Việt Nam. Anh Minsu là nhân viên công ty à?"
        },
        {
          "speaker": "민수",
          "ko": "네, 회사원입니다. 응우옌 씨는 학생이에요?",
          "vi": "Vâng. Anh Nguyễn là sinh viên à?"
        },
        {
          "speaker": "응우옌",
          "ko": "아니요, 학생이 아닙니다. 근로자입니다.",
          "vi": "Không, tôi không phải sinh viên. Tôi là người lao động."
        }
      ]
    },
    {
      "id": "L02-D002",
      "title": "Nói chuyện về gia đình",
      "situation": "Giờ nghỉ trưa, hai đồng nghiệp hỏi nhau về gia đình.",
      "lines": [
        {
          "speaker": "동료",
          "ko": "응우옌 씨, 가족이 몇 명이에요?",
          "vi": "Anh Nguyễn, gia đình anh có mấy người?"
        },
        {
          "speaker": "응우옌",
          "ko": "다섯 명이에요. 어머니, 아버지, 동생 두 명과 저입니다.",
          "vi": "Năm người. Mẹ, bố, hai em và tôi."
        },
        {
          "speaker": "동료",
          "ko": "아버지는 무슨 일을 하세요?",
          "vi": "Bố anh làm nghề gì?"
        },
        {
          "speaker": "응우옌",
          "ko": "농부입니다. 베트남에서 쌀을 키웁니다.",
          "vi": "Là nông dân. Bố trồng lúa ở Việt Nam."
        },
        {
          "speaker": "동료",
          "ko": "그래요? 저도 고향에서 농사를 지었어요.",
          "vi": "Vậy à? Tôi cũng từng làm nông ở quê."
        },
        {
          "speaker": "응우옌",
          "ko": "정말요? 우리 이야기를 더 해요.",
          "vi": "Thật sao? Chúng ta nói chuyện thêm đi."
        }
      ]
    }
  ],
  "culture": {
    "title": "Cách xưng hô và kính ngữ nơi làm việc",
    "items": [
      {
        "h": "Tên + 씨 và chức danh + 님",
        "body": "Đồng nghiệp ngang cấp thường gọi nhau bằng tên + 씨. Với cấp trên, gọi theo chức danh + 님 (사장님, 반장님), không gọi tên trống không."
      },
      {
        "h": "Thứ bậc và tuổi tác",
        "body": "Người Hàn coi trọng thứ bậc. Hãy dùng thể trang trọng hoặc -(으)세요 với cấp trên và người lớn tuổi."
      },
      {
        "h": "Hỏi chuyện gia đình",
        "body": "Hỏi về gia đình, quê quán là cách làm quen thông thường, không phải tò mò quá mức. Bạn cũng có thể hỏi lại như vậy."
      },
      {
        "h": "Đúng giờ",
        "body": "Đến sớm vài phút trước giờ làm thường được xem là lịch sự. Nếu đến muộn, hãy báo và xin lỗi (죄송합니다)."
      }
    ]
  }
}