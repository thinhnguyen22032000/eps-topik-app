  "dialogues": [
    {
      "id": "L09-D001",
      "title": "Đi làm bằng gì?",
      "situation": "Hỏi đồng nghiệp cách đến nhà máy.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "공장까지 어떻게 가요?",
          "vi": "Đi đến nhà máy bằng cách nào?"
        },
        {
          "speaker": "동료",
          "ko": "버스로 갈 수 있어요. 삼십 분 걸려요.",
          "vi": "Đi bằng xe buýt được. Mất 30 phút."
        },
        {
          "speaker": "응우옌",
          "ko": "지하철은 멀어요?",
          "vi": "Tàu điện ngầm có xa không?"
        },
        {
          "speaker": "동료",
          "ko": "아니요, 가까워요. 지하철이 더 빨라요.",
          "vi": "Không, gần. Tàu điện ngầm nhanh hơn."
        }
      ]
    }
