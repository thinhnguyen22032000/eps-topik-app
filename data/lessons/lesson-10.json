  "grammar": [
    {
      "id": "L10-G001",
      "pattern": "-지 마세요",
      "meaning": "Xin đừng…",
      "explanation": "Yêu cầu không làm gì; rất hay gặp trong lời dặn an toàn.",
      "formation": "Gốc động từ + -지 마세요",
      "examples": [
        {
          "ko": "기계를 만지지 마세요.",
          "vi": "Đừng chạm vào máy."
        },
        {
          "ko": "여기에서 담배를 피우지 마세요.",
          "vi": "Đừng hút thuốc ở đây."
        }
      ]
    },
    {
      "id": "L10-G002",
      "pattern": "-(으)ㄹ 때",
      "meaning": "Khi… / lúc…",
      "explanation": "Chỉ thời điểm xảy ra hành động hoặc trạng thái.",
      "formation": "Có patchim: -을 때 · Không: -ㄹ 때",
      "examples": [
        {
          "ko": "용접할 때 보안경을 쓰세요.",
          "vi": "Khi hàn hãy đeo kính bảo hộ."
        },
