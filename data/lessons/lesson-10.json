  "dialogues": [
    {
      "id": "L10-D001",
      "title": "Tổ trưởng giao việc",
      "situation": "Tổ trưởng yêu cầu chuẩn bị dụng cụ.",
      "lines": [
        {
          "speaker": "반장",
          "ko": "망치와 못을 가져오세요.",
          "vi": "Hãy mang búa và đinh đến."
        },
        {
          "speaker": "응우옌",
          "ko": "네. 장갑도 껴야 해요?",
          "vi": "Vâng. Có phải đeo găng tay không?"
        },
        {
          "speaker": "반장",
          "ko": "네, 일할 때 장갑을 끼세요. 못을 만지지 마세요.",
          "vi": "Có, khi làm việc hãy đeo găng tay. Đừng chạm tay vào đinh."
        },
        {
          "speaker": "응우옌",
          "ko": "알겠습니다. 작업 후에 청소할게요.",
          "vi": "Tôi hiểu rồi. Làm xong tôi sẽ dọn dẹp."
        }
      ]
    }
  ]
