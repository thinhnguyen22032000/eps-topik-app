        }
      ]
    },
    {
      "id": "L11-G002",
      "pattern": "-(으)면 안 되다",
      "meaning": "Không được…",
      "explanation": "Cấm đoán, không cho phép.",
      "formation": "Có patchim: -으면 안 되다 · Không: -면 안 되다",
      "examples": [
        {
          "ko": "기계를 만지면 안 됩니다.",
          "vi": "Không được chạm vào máy."
        },
        {
          "ko": "여기에서 담배를 피우면 안 돼요.",
          "vi": "Không được hút thuốc ở đây."
        }
      ]
    }
