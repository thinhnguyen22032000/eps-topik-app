  "dialogues": [
    {
      "id": "L11-D001",
      "title": "Xin nghỉ vì ốm",
      "situation": "Anh Nguyễn báo với giám đốc là mình bị ốm.",
      "lines": [
        {
          "speaker": "응우옌",
          "ko": "사장님, 머리가 아파서 일할 수 없어요.",
          "vi": "Giám đốc, tôi đau đầu nên không làm việc được."
        },
        {
          "speaker": "사장님",
          "ko": "감기에 걸렸어요? 병원에 가세요.",
          "vi": "Anh bị cảm à? Hãy đi bệnh viện."
        },
        {
          "speaker": "응우옌",
          "ko": "오늘 쉬어도 돼요?",
          "vi": "Hôm nay tôi nghỉ được không?"
