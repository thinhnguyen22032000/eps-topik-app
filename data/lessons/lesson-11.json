  "grammar": [
    {
      "id": "L11-G001",
      "pattern": "-아/어도 되다",
      "meaning": "Được phép…",
      "explanation": "Hỏi/cho phép làm gì: '…cũng được'.",
      "formation": "ㅏ,ㅗ + 아도 · còn lại + 어도 · 하다 → 해도 되다",
      "examples": [
        {
          "ko": "오늘 쉬어도 돼요?",
