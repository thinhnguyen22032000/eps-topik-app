  "grammar": [
    {
      "id": "L04-G001",
      "pattern": "이 / 그 / 저",
      "meaning": "Này / đó / kia",
      "explanation": "이: gần người nói; 그: gần người nghe; 저: xa cả hai.",
      "formation": "이/그/저 + danh từ",
      "examples": [
        {
