  "dialogues": [
    {
      "id": "L04-D001",
      "title": "Đồ vật của ai?",
      "situation": "Giám đốc hỏi về đồ đạc để quên ở văn phòng.",
      "lines": [
        {
          "speaker": "사장님",
          "ko": "응우옌 씨, 그 가방 안에 무엇이 있어요?",
          "vi": "Anh Nguyễn, trong cái túi đó có gì?"
        },
        {
          "speaker": "응우옌",
          "ko": "책하고 휴대폰이 있어요.",
          "vi": "Có sách và điện thoại."
        },
        {
          "speaker": "사장님",
          "ko": "이 휴대폰도 응우옌 씨 거예요?",
          "vi": "Cái điện thoại này cũng của anh à?"
        },
        {
          "speaker": "응우옌",
          "ko": "아니요, 그것은 제 것이 아닙니다. 친구 거예요.",
          "vi": "Không, đó không phải của tôi. Của bạn tôi."
        }
      ]
    }
  ]
