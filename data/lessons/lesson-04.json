      ]
    },
    {
      "id": "L04-G002",
      "pattern": "-도",
      "meaning": "Cũng",
      "explanation": "Thay cho -은/는, -이/가, -을/를 khi muốn nói 'cũng'.",
      "formation": "Danh từ + 도",
      "examples": [
        {
          "ko": "저도 근로자입니다.",
          "vi": "Tôi cũng là người lao động."
        },
