        { "id": "L17", "type": "dialog", "stem": "월급은 언제 받습니까?", "audio": "월급은 언제 받아요? 매달 이십오 일에 받아요.", "choices": ["오 일", "십오 일", "이십오 일", "삼십 일"], "answer": 2, "explanation": "이십오 일 = ngày 25." },
        { "id": "L18", "type": "dialog", "stem": "공장까지 얼마나 걸립니까?", "audio": "버스를 타고 공장에 가요. 삼십 분 걸려요.", "choices": ["십 분", "이십 분", "삼십 분", "한 시간"], "answer": 2, "explanation": "삼십 분 = 30 phút." },
        { "id": "L19", "type": "dialog", "stem": "먼저 무엇을 해야 합니까?", "audio": "이 기계는 사용하기 전에 사장님께 물어보세요.", "choices": ["사장님께 물어봅니다", "기계를 켭니다", "청소합니다", "퇴근합니다"], "answer": 0, "explanation": "사용하기 전에 = trước khi dùng → hỏi giám đốc." },
